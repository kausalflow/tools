{{- /* Public data feed, documented on /about/. One entry per tool, with absolute URLs. */ -}}
{{- $checks := site.Data.linkcheck | default dict -}}
{{- $items := slice -}}
{{- range where .Site.RegularPages "Type" "tools" -}}
{{- $links := slice -}}
{{- range .Params.links }}{{ $links = $links | append (dict "name" .name "url" .link) }}{{ end -}}
{{- $item := dict
  "title" .Title
  "url" .Permalink
  "summary" (.Params.summary | default .Summary | plainify)
  "features" (.Params.features | default slice)
  "links" $links
  "categories" (.Params.categories | default slice)
  "tags" (.Params.tags | default slice)
  "fields" (.Params.fields | default slice)
  "platforms" (.Params.platforms | default slice)
  "added" (.Date.Format "2006-01-02")
  "pricing" (.Params.pricing | default "unknown")
  "open_source" .Params.open_source
  "alternatives_to" (.Params.alternatives_to | default slice)
-}}
{{- with index $checks .File.ContentBaseName }}{{ $item = merge $item (dict "status" .status "last_checked" .checked) }}{{ end -}}
{{- $items = $items | append $item -}}
{{- end -}}
{{- jsonify (dict "indent" "  ") $items -}}
